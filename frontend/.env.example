# Backend API URL (Defaults to http://localhost:8000 if not specified)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Client & Drive / Sheet IDs (Optional / Configured for integrations)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
NEXT_PUBLIC_SPREADSHEET_ID=your-google-sheet-id
NEXT_PUBLIC_DRIVE_ZONE_A_FOLDER_ID=your-zone-a-folder-id
NEXT_PUBLIC_DRIVE_ZONE_B_FOLDER_ID=your-zone-b-folder-id
NEXT_PUBLIC_DRIVE_ZONE_C_FOLDER_ID=your-zone-c-folder-id
NEXT_PUBLIC_DRIVE_ZONE_D_FOLDER_ID=your-zone-d-folder-id
