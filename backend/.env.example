# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# CORS Configuration (Optional - Defaults to localhost frontend URLs if not set)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# M1 disease detection (weights stay outside git; export with ml/disease_detection/scripts/export_onnx.py)
# Optional: default is backend/models/m1/model.onnx (python scripts/fetch_model.py)
# M1_MODEL_PATH=
# M1_REFER_BELOW=0.95

# Optional CPU Grad-CAM (install requirements-explain.txt first)
# M1_EXPLAIN_ENABLED=false
# Default checkpoint: models/m1/best.pt, verified against model_card.json
# M1_CHECKPOINT_PATH=
# CPU intra-op threads for the optional PyTorch model (1-32; default 4)
# M1_EXPLAIN_THREADS=4
# Advisory RAG (ml/advisory/src/rag.py, src/api.py). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
ADVISORY_LLM_MODEL=google/gemini-3.8-flash
